# Scans sources et sorties générées (volumineux, non versionnés)
images/
output/

# Corpus d'entraînement et checkpoints (volumineux, téléchargés/générés)
training/timeuscorpus/
training/models/
training/*.log
training/train_log.txt
training/finetune_log.txt

# Jeu d'entraînement du fine-tuning : les transcriptions manuelles (.gt.txt)
# sont versionnées — c'est du travail humain irremplaçable — mais pas les
# images de lignes, que le pipeline régénère.
training/cadastre_gt/*.png

# Archives du dossier de saisie, preparees pour distribution aux benevoles :
# regenerables depuis training/cadastre_gt/, et trop volumineuses pour Git.
*.7z
*.zip

